{
  "name": "versioner-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Typed, framework-independent data versioning and migrations",
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc --noEmit -p packages/versions/tsconfig.json && tsc --noEmit -p packages/versioner/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run build && npm run typecheck && npm test && npm run smoke && npm run format:check",
    "prepack": "npm run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.0",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "semver": "7.8.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "workspaces": [
    "packages/versions",
    "packages/versioner"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brunocapdevila/versioner.git"
  }
}
